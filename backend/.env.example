# Copy to .env and fill in. .env is git-ignored.
# Supabase: use the Session pooler connection string (host ends in .pooler.supabase.com)
# Format: postgresql+psycopg://postgres.<project>:<password>@<host>:5432/postgres
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Optional: separate database for integration tests
# DATABASE_URL_TEST=postgresql+psycopg://USER:PASSWORD@HOST:5432/cliniccall_test

# Clinic business hours are evaluated in this timezone
CLINIC_TIMEZONE=Asia/Karachi